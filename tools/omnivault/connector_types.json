      "auth_error_patterns": [
        "(?i)password",
        "(?i)passwort",
        "(?i)credential",
        "(?i)authenticat",
        "(?i)login",
        "(?i)anmeld",
        "(?i)api ?key",
        "(?i)unauthori"
      ],
      "scripts": {
        "prologue": [
          "$ErrorActionPreference = 'Stop'",
          "$p = [Console]::In.ReadToEnd() | ConvertFrom-Json",
          "$dll = Join-Path $p.sdk_path 'PsrApi.dll'",
          "if (-not (Test-Path $dll)) { throw \"PsrApi.dll not found in $($p.sdk_path)\" }",
          "Add-Type -Path $dll",
          "function Await($task) { $task.GetAwaiter().GetResult() }",
          "$api = New-Object PsrApi.PsrApi($p.endpoint)",
          "if ($p.auth_mode -eq 'api_key') {",
          "  Await ($api.AuthenticationManagerV2.LoginWithApiKey($p.api_key))",
          "} else {",
          "  $flow = $api.AuthenticationManagerV2.StartNewAuthentication($p.database, $p.username)",
          "  Await ($flow.StartLogin())",
          "  for ($i = 0; -not $flow.IsAuthenticated -and $i -lt 5; $i++) {",
          "    $req = $flow.GetNextRequirement()",
          "    $auth = $req.PossibleRequirements | Where-Object { $_.IsPasswordAuthentication() } | Select-Object -First 1",
          "    if (-not $auth) { throw 'The account requires a login method other than password (e.g. MFA). Use an API key instead.' }",
          "    if ($auth.PSObject.Properties['Fields']) {",
          "      foreach ($f in $auth.Fields) {",
          "        if ($f.Key -match 'user') { $f.Value = $p.username } else { $f.Value = $p.password }",
          "      }",
          "    }",
          "    Await ($flow.Authenticate($auth))",
          "  }",
          "  if (-not $flow.IsAuthenticated) { throw 'Login failed.' }",
          "}",
          "function ItemValue($container, $type) {",
          "  ($container.Items | Where-Object { [string]$_.ContainerItemType -eq $type } | Select-Object -First 1).Value",
          "}"
        ],
        "search": [
          "$type = [PsrApi.Data.Enums.PsrContainerType]::Password",
          "$filter = Await ($api.ContainerManager.GetContainerListFilter($type, $true))",
          "if ($p.query) {",
          "  $group = $filter.FilterGroups | Where-Object { $_ -is [PsrApi.Data.PsrListFilterGroupContent] } | Select-Object -First 1",
          "  if (-not $group) { $group = New-Object PsrApi.Data.PsrListFilterGroupContent; $filter.FilterGroups.Add($group) }",
          "  if (-not $group.SearchList) { $group.SearchList = New-Object 'System.Collections.Generic.List[PsrApi.Data.PsrListFilterObjectContent]' }",
          "  $o = New-Object PsrApi.Data.PsrListFilterObjectContent",
          "  $o.Search = [string]$p.query",
          "  $o.FilterActive = $true",
          "  $group.SearchList.Add($o)",
          "}",
          "try { $filter.First = [int]$p.max } catch { }",
          "$list = Await ($api.ContainerManager.GetContainerList($type, $filter, $null))",
          "$r = $list | Select-Object -First ([int]$p.max) | ForEach-Object {",
          "  $name = $_.Name",
          "  if (-not $name) { $name = ItemValue $_ 'ContainerItemText' }",
          "  [pscustomobject]@{ id = [string]$_.Id; name = [string]$name; username = [string](ItemValue $_ 'ContainerItemUserName');",
          "                     detail = [string](ItemValue $_ 'ContainerItemHostName') }",
          "}",
          "try { $api.AuthenticationManagerV2.Logout() | Out-Null } catch { }",
          "ConvertTo-Json -InputObject @($r) -Compress"
        ],
        "get": [
          "$c = Await ($api.ContainerManager.GetContainer([guid]$p.id))",
          "$pwItem = $c.Items | Where-Object { [string]$_.ContainerItemType -eq 'ContainerItemPassword' } | Select-Object -First 1",
          "$pw = ''",
          "if ($pwItem) { $pw = Await ($api.ContainerManager.DecryptContainerItem($pwItem, 'OmniWrench')) }",
          "$user = ItemValue $c 'ContainerItemUserName'",
          "try { $api.AuthenticationManagerV2.Logout() | Out-Null } catch { }",
          "ConvertTo-Json -InputObject ([pscustomobject]@{ username = [string]$user; password = [string]$pw }) -Compress"
        ]
      }
    },
