{
  "_doc": [
    "Symbol-Pakete von IconForge. Lucide ist eingebaut, alle anderen werden bei Bedarf aus dem npm-Registry geladen.",
    "package: npm-Paketname. Geladen wird die neueste Version, die mindestens 14 Tage alt ist.",
    "variants: {id: {dir, include, strip, label}} - dir relativ zum Paketordner; include = Regex auf den Dateinamen",
    "          (ohne .svg), strip = Regex, der vom Namen entfernt wird (z. B. Varianten-Suffix).",
    "recursive: auch Unterordner einlesen; categories_from_subdirs: Unterordner = Kategorie.",
    "meta: Format der Metadaten-Datei (Schlagwörter/Kategorien), siehe packs.py.",
    "license: Schlüssel aus licenses.json. brands: Paket enthält Markenlogos (Markenrecht beachten)."
  ],
  "packs": {
    "lucide": {"name": "Lucide", "builtin": true, "license": "ISC", "homepage": "https://lucide.dev",
               "variants": {"default": {"label": "Outline"}}},
    "tabler": {"name": "Tabler Icons", "package": "@tabler/icons", "license": "MIT", "homepage": "https://tabler.io/icons",
               "variants": {"outline": {"dir": "icons/outline", "label": "Outline"},
                            "filled": {"dir": "icons/filled", "label": "Filled"}},
               "meta": {"file": "icons.json", "format": "tabler"}},
    "phosphor": {"name": "Phosphor Icons", "package": "@phosphor-icons/core", "license": "MIT", "homepage": "https://phosphoricons.com",
                 "variants": {"regular": {"dir": "assets/regular", "label": "Regular"},
                              "bold": {"dir": "assets/bold", "strip": "-bold$", "label": "Bold"},
                              "light": {"dir": "assets/light", "strip": "-light$", "label": "Light"},
                              "thin": {"dir": "assets/thin", "strip": "-thin$", "label": "Thin"},
                              "fill": {"dir": "assets/fill", "strip": "-fill$", "label": "Fill"},
                              "duotone": {"dir": "assets/duotone", "strip": "-duotone$", "label": "Duotone"}}},
    "heroicons": {"name": "Heroicons", "package": "heroicons", "license": "MIT", "homepage": "https://heroicons.com",
                  "variants": {"outline": {"dir": "24/outline", "label": "Outline 24"},
                               "solid": {"dir": "24/solid", "label": "Solid 24"},
                               "mini": {"dir": "20/solid", "label": "Mini 20"},
                               "micro": {"dir": "16/solid", "label": "Micro 16"}}},
    "bootstrap": {"name": "Bootstrap Icons", "package": "bootstrap-icons", "license": "MIT", "homepage": "https://icons.getbootstrap.com",
                  "variants": {"default": {"dir": "icons", "label": "Standard"}}},
    "mdi": {"name": "Material Design Icons (Community)", "package": "@mdi/svg", "license": "Apache-2.0",
            "homepage": "https://pictogrammers.com/library/mdi/",
            "variants": {"default": {"dir": "svg", "label": "Standard"}},
            "meta": {"file": "meta.json", "format": "mdi"}},
    "material": {"name": "Material Symbols (Google)", "package": "@material-design-icons/svg", "license": "Apache-2.0",
                 "homepage": "https://fonts.google.com/icons",
                 "variants": {"filled": {"dir": "filled", "label": "Filled"}, "outlined": {"dir": "outlined", "label": "Outlined"},
                              "round": {"dir": "round", "label": "Round"}, "sharp": {"dir": "sharp", "label": "Sharp"},
                              "two-tone": {"dir": "two-tone", "label": "Two-tone"}}},
    "fluent": {"name": "Fluent UI System Icons (Microsoft)", "package": "@fluentui/svg-icons", "license": "MIT",
               "homepage": "https://github.com/microsoft/fluentui-system-icons",
               "variants": {"regular": {"dir": "icons", "include": "_24_regular$", "strip": "_24_regular$", "label": "Regular 24"},
                            "filled": {"dir": "icons", "include": "_24_filled$", "strip": "_24_filled$", "label": "Filled 24"}}},
    "carbon": {"name": "Carbon Icons (IBM)", "package": "@carbon/icons", "license": "Apache-2.0", "homepage": "https://carbondesignsystem.com/elements/icons/library/",
               "variants": {"default": {"dir": "svg/32", "label": "32 px"}}, "recursive": true, "categories_from_subdirs": true},
    "fontawesome": {"name": "Font Awesome Free", "package": "@fortawesome/fontawesome-free", "license": "CC-BY-4.0",
                    "homepage": "https://fontawesome.com", "brands_variant": "brands",
                    "variants": {"solid": {"dir": "svgs/solid", "label": "Solid"}, "regular": {"dir": "svgs/regular", "label": "Regular"},
                                 "brands": {"dir": "svgs/brands", "label": "Brands"}},
                    "meta": {"file": "metadata/icon-families.json", "format": "fontawesome"}},
    "remix": {"name": "Remix Icon", "package": "remixicon", "license": "Apache-2.0", "homepage": "https://remixicon.com",
              "variants": {"line": {"dir": "icons", "include": "-line$", "strip": "-line$", "label": "Line"},
                           "fill": {"dir": "icons", "include": "-fill$", "strip": "-fill$", "label": "Fill"}},
              "recursive": true, "categories_from_subdirs": true},
    "mingcute": {"name": "MingCute", "package": "mingcute_icon", "license": "Apache-2.0", "homepage": "https://www.mingcute.com",
                 "variants": {"line": {"dir": "svg", "include": "_line$", "strip": "_line$", "label": "Line"},
                              "fill": {"dir": "svg", "include": "_fill$", "strip": "_fill$", "label": "Fill"}},
                 "recursive": true, "categories_from_subdirs": true},
    "iconoir": {"name": "Iconoir", "package": "iconoir", "license": "MIT", "homepage": "https://iconoir.com",
                "variants": {"regular": {"dir": "icons/regular", "label": "Regular"}, "solid": {"dir": "icons/solid", "label": "Solid"}}},
    "ionicons": {"name": "Ionicons", "package": "ionicons", "license": "MIT", "homepage": "https://ionic.io/ionicons",
                 "variants": {"outline": {"dir": "dist/svg", "include": "-outline$", "strip": "-outline$", "label": "Outline"},
                              "sharp": {"dir": "dist/svg", "include": "-sharp$", "strip": "-sharp$", "label": "Sharp"},
                              "filled": {"dir": "dist/svg", "include": "^(?!.*-(outline|sharp)$)", "label": "Filled"}}},
    "octicons": {"name": "Octicons (GitHub)", "package": "@primer/octicons", "license": "MIT", "homepage": "https://primer.style/octicons",
                 "variants": {"24": {"dir": "build/svg", "include": "-24$", "strip": "-24$", "label": "24 px"},
                              "16": {"dir": "build/svg", "include": "-16$", "strip": "-16$", "label": "16 px"}},
                 "meta": {"file": "build/data.json", "format": "octicons"}},
    "feather": {"name": "Feather", "package": "feather-icons", "license": "MIT", "homepage": "https://feathericons.com",
                "variants": {"default": {"dir": "dist/icons", "label": "Standard"}}},
    "boxicons": {"name": "Boxicons", "package": "boxicons", "license": "MIT", "homepage": "https://boxicons.com",
                 "brands_variant": "logos",
                 "variants": {"regular": {"dir": "svg/regular", "strip": "^bx-", "label": "Regular"},
                              "solid": {"dir": "svg/solid", "strip": "^bxs-", "label": "Solid"},
                              "logos": {"dir": "svg/logos", "strip": "^bxl-", "label": "Logos"}}},
    "eva": {"name": "Eva Icons", "package": "eva-icons", "license": "MIT", "homepage": "https://akveo.github.io/eva-icons",
            "variants": {"outline": {"dir": "outline/svg", "strip": "-outline$", "label": "Outline"},
                         "fill": {"dir": "fill/svg", "label": "Fill"}}},
    "majesticons": {"name": "Majesticons", "package": "majesticons", "license": "MIT", "homepage": "https://www.majesticons.com",
                    "variants": {"line": {"dir": "line", "strip": "-line$", "label": "Line"}, "solid": {"dir": "solid", "label": "Solid"}}},
    "teenyicons": {"name": "Teenyicons", "package": "teenyicons", "license": "MIT", "homepage": "https://teenyicons.com",
                   "variants": {"outline": {"dir": "outline", "label": "Outline"}, "solid": {"dir": "solid", "label": "Solid"}}},
    "lineicons": {"name": "Lineicons Free", "package": "lineicons", "license": "MIT", "homepage": "https://lineicons.com",
                  "variants": {"regular": {"dir": "assets/svgs/regular", "label": "Regular"}}},
    "lineawesome": {"name": "Line Awesome", "package": "line-awesome", "license": "MIT", "homepage": "https://icons8.com/line-awesome",
                    "variants": {"default": {"dir": "svg", "label": "Standard"}}},
    "pixelarticons": {"name": "Pixelarticons", "package": "pixelarticons", "license": "MIT", "homepage": "https://pixelarticons.com",
                      "variants": {"default": {"dir": "svg", "label": "Pixel"}}},
    "pixel-hackernoon": {"name": "Pixel Icon Library (HackerNoon)", "package": "@hackernoon/pixel-icon-library", "license": "MIT",
                         "homepage": "https://pixeliconlibrary.com", "brands_variant": "brands",
                         "variants": {"regular": {"dir": "icons/SVG/regular", "label": "Regular"},
                                      "solid": {"dir": "icons/SVG/solid", "label": "Solid"},
                                      "brands": {"dir": "icons/SVG/brands", "label": "Brands"}}},
    "codicons": {"name": "Codicons (VS Code)", "package": "@vscode/codicons", "license": "CC-BY-4.0",
                 "homepage": "https://microsoft.github.io/vscode-codicons/",
                 "variants": {"default": {"dir": "src/icons", "label": "Standard"}}},
    "simpleicons": {"name": "Simple Icons (Markenlogos)", "package": "simple-icons", "license": "CC0-1.0",
                    "homepage": "https://simpleicons.org", "brands_variant": "default",
                    "variants": {"default": {"dir": "icons", "label": "Logos"}},
                    "meta": {"file": "data/simple-icons.json", "format": "simpleicons"}}
  }
}
